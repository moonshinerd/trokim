# Configurações da API Trokim
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Banco de dados SQLite local
DATABASE_URL=sqlite+aiosqlite:///trokim.db

# Provedor de Modelo de Linguagem (Opcional no modo mock/deterministico)
# Exemplos: ollama/llama3.2, openrouter/meta-llama/llama-3.1-8b-instruct
LLM_MODEL=ollama/llama3.2
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=

# RAG
RAG_SIMILARITY_THRESHOLD=0.15
RAG_TOP_K=3
