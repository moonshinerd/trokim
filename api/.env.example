# Configurações da API Trokim
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Banco de dados SQLite local
DATABASE_URL=sqlite+aiosqlite:///trokim.db

# Modelo de linguagem via LiteLLM: troque o modelo só por configuração.
# LLM_PROVIDER: litellm (padrão, qualquer modelo), ollama (cliente direto) ou mock (testes/CI).
# LLM_MODEL no formato do LiteLLM. Exemplos:
#   ollama/qwen2.5                (local, recomendado, não envia dados a terceiros)
#   ollama/gemma4:26b             (local, maior e mais lento)
#   openai/gpt-4o-mini            (nuvem; exige LLM_API_KEY)
#   openrouter/meta-llama/llama-3.1-8b-instruct  (nuvem; exige LLM_API_KEY)
LLM_PROVIDER=litellm
LLM_MODEL=ollama/qwen2.5
# Deixe vazio para usar o padrão do provedor. Ollama local: http://localhost:11434
LLM_API_BASE=
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_TITLE_TIMEOUT=25
# Modelo leve só para dar título às conversas (vazio = usa LLM_MODEL).
# Recomendado: ollama pull qwen2.5:1.5b
LLM_TITLE_MODEL=ollama/qwen2.5:1.5b
# Raciocínio estendido de modelos locais que o suportam (mais lento). Padrão: false
LLM_THINKING=false

# RAG
RAG_SIMILARITY_THRESHOLD=0.15
RAG_TOP_K=3
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_VECTOR_DB_PATH=data/vector_store.db
RAG_CHUNK_MAX_CHARS=500
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_HYBRID_ALPHA=0.3
