{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gabarito multimodal sintético do Trokim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed",
    "synthetic_only",
    "personal_data",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seed": {
      "type": "integer"
    },
    "synthetic_only": {
      "const": true
    },
    "personal_data": {
      "const": {
        "name": "Pessoa Exemplo Fictícia",
        "cpf": "000.000.000-00",
        "account": "0000000-0",
        "branch": "0000"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family_id",
          "path",
          "split",
          "kind",
          "bank",
          "media_type",
          "degradation",
          "expected_quality",
          "expected_fields",
          "recoverable_fields",
          "expected_transactions",
          "recoverable_transactions",
          "demo",
          "early_sample"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D[0-9]{2}$"
          },
          "family_id": {
            "type": "string",
            "pattern": "^F[0-9]{2}$"
          },
          "path": {
            "type": "string",
            "pattern": "^research/synthetic_data/document_images/D[0-9]{2}\\.(png|jpg|pdf)$"
          },
          "split": {
            "enum": [
              "calibration",
              "validation"
            ]
          },
          "kind": {
            "enum": [
              "pix_receipt",
              "boleto",
              "card_invoice"
            ]
          },
          "bank": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "enum": [
              "image/png",
              "image/jpeg",
              "application/pdf"
            ]
          },
          "degradation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "level",
              "parameters"
            ],
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "blur",
                  "low_light",
                  "rotation",
                  "perspective",
                  "crop",
                  "jpeg",
                  "reflection"
                ]
              },
              "level": {
                "enum": [
                  "none",
                  "mild",
                  "moderate",
                  "severe"
                ]
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "radius": {
                    "type": "number",
                    "minimum": 0
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "degrees": {
                    "type": "number"
                  },
                  "shear": {
                    "type": "number"
                  },
                  "quality": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "essential_field_hidden": {
                    "const": true
                  }
                }
              }
            }
          },
          "expected_quality": {
            "enum": [
              "legible",
              "partial",
              "illegible"
            ]
          },
          "expected_fields": {
            "$ref": "#/$defs/fields"
          },
          "recoverable_fields": {
            "$ref": "#/$defs/fields"
          },
          "expected_transactions": {
            "$ref": "#/$defs/rows"
          },
          "recoverable_transactions": {
            "$ref": "#/$defs/rows"
          },
          "demo": {
            "type": "boolean"
          },
          "early_sample": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "pix_receipt"
                }
              }
            },
            "then": {
              "properties": {
                "expected_fields": {
                  "required": [
                    "bank",
                    "date",
                    "amount",
                    "counterparty"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "boleto"
                }
              }
            },
            "then": {
              "properties": {
                "expected_fields": {
                  "required": [
                    "bank",
                    "due_date",
                    "amount",
                    "counterparty"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "card_invoice"
                }
              }
            },
            "then": {
              "properties": {
                "expected_fields": {
                  "required": [
                    "bank",
                    "due_date",
                    "total"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "expected_quality": {
                  "const": "illegible"
                }
              }
            },
            "then": {
              "properties": {
                "recoverable_fields": {
                  "maxProperties": 0
                },
                "recoverable_transactions": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bank": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "amount": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "counterparty": {
          "type": "string",
          "minLength": 1
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "total": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "description",
          "amount",
          "installment"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "installment": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
